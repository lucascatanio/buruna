# database
DB_NAME=buruna
DB_USER=buruna_user
DB_PASSWORD=changeme

# jwt
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_256_bits
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800

# google cloud storage
GCS_BUCKET_NAME=buruna-files
GCS_CREDENTIALS_PATH=/app/gcs-credentials.json

# frontend
APP_FRONTEND_URL=http://localhost
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_HCAPTCHA_SITE_KEY=sua-sitekey

# email
RESEND_API_KEY=SUA_API_KEY_DO_RESEND
ADMIN_EMAIL=admin@seudominio.com.br
APP_MAIL_FROM="Burūna <noreply@buruna.com.br>"

# upload
MAX_FILE_SIZE_MB=500

# jobs
APP_JOBS_SECRET=dev-secret-change-me

# rate limit
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_HOUR=10
RATE_LIMIT_FEEDBACK_PER_HOUR=3
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=3

# hcaptcha
HCAPTCHA_SECRET=