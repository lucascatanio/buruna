# db
DB_NAME=buruna
DB_USER=buruna_user
DB_PASSWORD=changeme

# jwt
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_256_bits
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800

# gcs
GCS_BUCKET_NAME=buruna-files
GCS_CREDENTIALS_PATH=/app/gcs-credentials.json

# gmail smtp
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
ADMIN_EMAIL=admin@gmail.com

# upload
MAX_FILE_SIZE_MB=500

# jobs (Cloud Scheduler secret)
APP_JOBS_SECRET=

# rate limit
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_HOUR=10

# cors
APP_CORS_ALLOWED_ORIGIN=https://seudominio.com.br

# email remetente
APP_MAIL_FROM=noreply@buruna.com.br
